# Configurações do Supabase (Obrigatório para persistência e autenticação em nuvem)
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-anonima-publica"
SUPABASE_SERVICE_ROLE_KEY="sua-chave-service-role-privada-servidor"

# Gemini API (Usado no servidor para geração inteligente e explicações tutor)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# YouTube Data API v3 (Opcional para busca direta de videoaulas)
YOUTUBE_API_KEY=""

# Configuração do Ambiente do Servidor
PORT=3000
APP_URL="http://localhost:3000"
